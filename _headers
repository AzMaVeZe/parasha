# כותרות HTTP שמוגשות על ידי Cloudflare Pages.
# ב-GitHub Pages לא ניתן היה להגדיר כותרות כלל, ולכן ה-CSP ישב בתגית <meta>
# ב-index.html — פחות אפקטיבי. כאן הוא כותרת אמיתית, שנאכפת גם על תגובות
# שאינן HTML ופועלת לפני שהדפדפן מתחיל לפרסר את העמוד.
#
# הכתובות המותרות ב-connect-src ו-frame-src חייבות להישאר זהות לתגית ה-<meta>
# שב-index.html, אחרת אחת מהן תחסום את השנייה.
#
# frame-ancestors 'self' ולא 'none': מציג ה-PDF באתר הוא iframe שטוען קובץ
# מאותו דומיין. 'none' חוסם גם הטמעה עצמית, ומכבה את הצפייה בדפים.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://www.hebcal.com https://parasha-newsletter.azma.workers.dev; frame-src 'self' https://open.spotify.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# הקבצים מכילים עברית. בלי charset מפורש הדפדפן מנחש — סקריפט שנטען מתוך הדף
# יורש UTF-8 מה-<meta> וזה עובד, אבל פנייה ישירה לקובץ מתפרשת כ-Latin-1.
/tokens/*
  Content-Type: text/css; charset=utf-8

# נכסים בעלי שם שאינו משתנה — אפשר לשמור אותם לאורך זמן
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/previews/*
  Cache-Control: public, max-age=604800
/assets/riddles/*
  Cache-Control: public, max-age=604800
/assets/pdfs/*
  Cache-Control: public, max-age=604800

# קבצים שמתעדכנים עם כל שינוי בתוכן — לוודא שהדפדפן בודק מולנו
/index.html
  Cache-Control: public, max-age=0, must-revalidate
# עמודי הדפים הסטטיים (נוצרים ב-scripts/build-pages.js) — מתעדכנים עם js/data.js
/p/*
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
# הקבצים כוללים עברית — בלי charset מפורש הם מתפרשים כ-Latin-1
/robots.txt
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/js/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/javascript; charset=utf-8
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/css; charset=utf-8
